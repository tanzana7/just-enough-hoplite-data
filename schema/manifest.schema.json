{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/just-enough-hoplite/manifest.schema.json",
  "title": "JEH manifest schema v2",
  "type": "object",
  "required": ["schema_version", "data_version", "minecraft_versions", "published_at", "files"],
  "properties": {
    "schema_version": {"const": 2},
    "data_version": {"type": "integer", "minimum": 1},
    "minecraft_versions": {
      "type": "object", "required": ["min_inclusive", "max_exclusive"],
      "properties": {"min_inclusive": {"type": "string"}, "max_exclusive": {"type": "string"}},
      "additionalProperties": true
    },
    "published_at": {"type": "string", "format": "date-time"},
    "files": {"type": "array", "items": {
      "type": "object", "required": ["url", "sha256", "size"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "size": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    }},
    "changelog": {
      "type": "object", "required": ["en_us"],
      "properties": {"en_us": {"type": "string"}, "ja_jp": {"type": "string"}},
      "additionalProperties": {"type": "string"}
    },
    "id_redirects": {
      "type": "object", "propertyNames": {"pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"},
      "additionalProperties": {"type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"}
    }
  },
  "additionalProperties": true
}
